  m_Name: Radial 360 Mask
  m_EditorClassIdentifier: 
  m_functionInfo: "// Made with Amplify Shader Editor v1.9.9.8\n// Available at the
    Unity Asset Store - http://u3d.as/y3X \n/*ASEBEGIN\nVersion=19908\nNode;AmplifyShaderEditor.CustomExpressionNode,
    AmplifyShaderEditor, Version=0.0.0.0, Culture=neutral, PublicKeyToken=null;1;-320,0;Inherit;False;
    #ifndef PI$    #define PI 3.14159265359$#endif$$// Move UV so center is at 0,0$   
    float2 p = uv - float2(0.5, 0.5)@$$    // Angle in radians, range -PI to PI$   
    float angle = atan2(p.y, p.x)@$$    // Remap to 0..1$    angle = angle / (2.0
    * PI)@$    angle = frac(angle + 1.0)@$$    // Shift start point$    angle = frac(angle
    - origin + 1.0)@$$    // Reverse direction if needed$    if (clockwise > 0.5)$   
    {$        angle = 1.0 - angle@$    }$$    // Clamp fill$    fillAmount = saturate(fillAmount)@$$   
    // Hard mask$    return step(angle, fillAmount)@;1;File;4;True;uv;FLOAT2;0,0;In;;Inherit;False;True;fill_amount;FLOAT;0;In;;Inherit;False;True;origin;FLOAT;0;In;;Inherit;False;True;clockwise;INT;0;In;;Inherit;False;radial_mask;False;False;0;47dfcb1673c84f6bbcef229b7a0374ea;False;4;0;FLOAT2;0,0;False;1;FLOAT;0;False;2;FLOAT;0;False;3;INT;0;False;1;FLOAT;0\nNode;AmplifyShaderEditor.TextureCoordinatesNode,
