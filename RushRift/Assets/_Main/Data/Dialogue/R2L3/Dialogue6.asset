  dialogueLines:
  - name: ???
    audioAndLines:
    - dialogueAudioName: 2-3Carter1
      typingSpeed: 0.05
      dialogueDelay: 4
      line:
        text: "Split and\u2026 Aid\u2026 Is it? Well\u2026 It's only fair if I introduced
          myself as well then\u2026\r\n\n"
  - name: Carter
    audioAndLines:
    - dialogueAudioName: 2-3Carter2
      typingSpeed: 0.05
      dialogueDelay: 5
      line:
        text: My name is Robert A. Carter, and I am the architect or all that you
          see around you right now.
  - name: Split
    audioAndLines:
    - dialogueAudioName: Split11
      typingSpeed: 0.05
      dialogueDelay: 4
      line:
        text: "Carter? Aren't you dead? You used to be the head of Accolade ages
          ago\u2026"
  - name: Carter
    audioAndLines:
    - dialogueAudioName: 2-3Carter3
      typingSpeed: 0.05
      dialogueDelay: 5
      line:
        text: "My \u201Cuntimely demise\u201D had to be fabricated so I could focus
          on something greater than anyone has ever seen before!"
