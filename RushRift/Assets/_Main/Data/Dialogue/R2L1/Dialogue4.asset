  savingMethod: 1
  conditions: []
  dialogueLines:
  - name: Split
    audioAndLines:
    - dialogueAudioName: Split7
      typingSpeed: 0.05
      dialogueDelay: 3
      line:
        text: Aid what the fuck was that? Did you hear that guy talking to me earlier?
  - name: Aid
    audioAndLines:
    - dialogueAudioName: Aid 6
      typingSpeed: 0.05
      dialogueDelay: 2.75
      line:
        text: "Split! You are back online! I thought I lost you for a second there\u2026"
  - name: Split
    audioAndLines:
    - dialogueAudioName: Split8
      typingSpeed: 0.05
      dialogueDelay: 3
      line:
        text: "No no, I seem to have reached a second layer of Accolade\u2019s runner-net
          firewall"
  - name: Aid
    audioAndLines:
    - dialogueAudioName: Aid 5
      typingSpeed: 0.05
      dialogueDelay: 3.5
      line:
        text: That's great! Though I imagine security here is going to be much tighter
          now. Good luck!
