--- !u!114 &5618211057735540332
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: aefe974bcb4732d42a19ef758cf58eef, type: 3}
  m_Name: DialogueSO
  m_EditorClassIdentifier: 
  dialogueName: Dialogue9
  savingMethod: 1
  conditions: []
  dialogueLines:
  - name: Aid
    audioAndLines:
    - dialogueAudioName: Aid11
      typingSpeed: 0.05
      dialogueDelay: 1
      line:
        text: "Wow\u2026"
  - name: Split
    audioAndLines:
    - dialogueAudioName: Split18
      typingSpeed: 0.05
      dialogueDelay: 1.5
      line:
        text: What's up?
  - name: Aid
    audioAndLines:
    - dialogueAudioName: Aid12
      typingSpeed: 0.05
      dialogueDelay: 3
      line:
        text: "It might be nothing, but the code on this one looks.. particular\u2026"
  - name: Split
    audioAndLines:
    - dialogueAudioName: Split15
      typingSpeed: 0.05
      dialogueDelay: 3
      line:
        text: "Particular? That might be good\u2026 You never know with Accolade\u2019s
          software"
  - name: Carter
    audioAndLines:
    - dialogueAudioName: 3-3Carter1take2
      typingSpeed: 0.05
      dialogueDelay: 1.2
      line:
        text: "\u2026 oh uh \u2026"
  - name: Split
    audioAndLines:
    - dialogueAudioName: Split14
      typingSpeed: 0.05
      dialogueDelay: 2
      line:
        text: "What's wrong \u201CMr. Architect of this domain\u201D?"
  - name: Carter
    audioAndLines:
    - dialogueAudioName: 3-3Carter2
      typingSpeed: 0.05
      dialogueDelay: 5
      line:
        text: "Well, like I said\u2026 no one's ever gotten this far before\u2026
          I'm ashamed to admit this but, I don't know what happens when you cross
          this one\u2026"
  - name: Aid
    audioAndLines:
    - dialogueAudioName: Aid14
      typingSpeed: 0.05
      dialogueDelay: 3.5
      line:
        text: "I'm starting to think this might not be good after all Split\u2026"
  - name: Split
    audioAndLines:
    - dialogueAudioName: Split13
      typingSpeed: 0.05
      dialogueDelay: 2.75
      line:
        text: I have a feeling this will be just fine!
