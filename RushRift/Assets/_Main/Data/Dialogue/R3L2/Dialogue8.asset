  dialogueName: Dialogue8
  savingMethod: 1
  conditions: []
  dialogueLines:
  - name: Carter
    audioAndLines:
    - dialogueAudioName: 3-2 Carter 1
      typingSpeed: 0.05
      dialogueDelay: 6
      line:
        text: "Alright \u201CSplit\u201D... Maybe you are more\u2026 Resourceful\u2026
          Then I anticipated. I do have to admit that no one has gotten into this
          level of our runner net before you\u2026"
  - name: Split
    audioAndLines:
    - dialogueAudioName: Split 19
      typingSpeed: 0.05
      dialogueDelay: 1
      line:
        text: "Uhh.. thanks, I guess\u2026"
  - name: Carter
    audioAndLines:
    - dialogueAudioName: 3-2 Carter 2 take 3
      typingSpeed: 0.05
      dialogueDelay: 4
      line:
        text: "Oh yes, many have tried, but\u2026 none have ever succeeded\u2026"
  - name: Split
    audioAndLines:
    - dialogueAudioName: Split 17
      typingSpeed: 0.05
      dialogueDelay: 3
      line:
        text: Hey uhh Aid, you still here? Can you still hear this guy?
  - name: Aid
    audioAndLines:
    - dialogueAudioName: Aid 13
      typingSpeed: 0.05
      dialogueDelay: 1
      line:
        text: "Sadly, yes\u2026"
