--- !u!114 &5903061314418116016
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: aefe974bcb4732d42a19ef758cf58eef, type: 3}
  m_Name: DialogueSO
  m_EditorClassIdentifier: 
  dialogueName: Dialogue7
  savingMethod: 1
  conditions: []
  dialogueLines:
  - name: Aid
    audioAndLines:
    - dialogueAudioName: 
      typingSpeed: 0.05
      dialogueDelay: 3
      line:
        text: "I can't believe Carter is still alive\u2026 No wonder Accolade never
          seemed to change after his passing\u2026"
  - name: Split
    audioAndLines:
    - dialogueAudioName: 
      typingSpeed: 0.05
      dialogueDelay: 2.5
      line:
        text: "The CEO of a multinational megacorp turns out to be evil\u2026 What
          a surprise! "
  - name: Carter
    audioAndLines:
    - dialogueAudioName: 
      typingSpeed: 0.05
      dialogueDelay: 2
      line:
        text: "You two are just too closed minded to understand the bigger picture\u2026"
